{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal" } }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5000" }
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=SwitchPortFinder;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "AutoMigrate": false
  },
  "Security": {
    "KeysPath": "keys"
  },
  "Snmp": { "TimeoutMs": 5000, "Retries": 1, "Port": 161, "MaxRepetitions": 10 },
  "Discovery": { "MaxParallelScans": 5, "OfflineAfterMinutes": 60, "StaleAfterDays": 7, "ScanIntervalMinutes": 0, "PerVlanTimeoutMs": 1500, "PerVlanParallelism": 4, "DnsTimeoutMs": 2000, "HostnameRefreshHours": 24 },
  "Export": { "MaxDeviceRows": 250000 },
  "Import": { "MaxRows": 10000, "MaxFileBytes": 10485760, "PreviewTtlMinutes": 30 }
}
